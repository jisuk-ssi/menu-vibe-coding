{"openapi":"3.1.0","info":{"title":"메뉴 관리 API 명세서","description":"Spring Data JPA 수업용 프로젝트(chap06)의 API 명세서다. 메뉴와 카테고리 조회, 메뉴 등록·수정·삭제를 제공한다.","contact":{"name":"Ohgiraffers 강사팀","email":"owl.ohgiraffers@gmail.com"},"version":"v1"},"servers":[{"url":"http://localhost:8080","description":"Generated server url"}],"tags":[{"name":"Menu","description":"메뉴 조회 및 관리 API"},{"name":"Category","description":"카테고리 조회 API"}],"paths":{"/api/menus/{menuCode}":{"get":{"tags":["Menu"],"summary":"메뉴 상세 조회","description":"정상 응답은 ResponseMessage 형식이며 result.menu에 조회한 메뉴가 담깁니다.","operationId":"findMenuByCode","parameters":[{"name":"menuCode","in":"path","description":"조회할 메뉴 코드","required":true,"schema":{"type":"integer","format":"int32"},"example":1}],"responses":{"200":{"description":"메뉴 조회 성공","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ResponseMessage"}}}},"404":{"description":"해당 코드의 메뉴가 없음","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ResponseMessage"}}}},"500":{"description":"서버 내부 오류","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ResponseMessage"}}}}}},"put":{"tags":["Menu"],"summary":"메뉴 수정","description":"정상 응답은 ResponseMessage 형식이며 result.menu에 수정된 메뉴가 담깁니다.","operationId":"updateMenu","parameters":[{"name":"menuCode","in":"path","description":"수정할 메뉴 코드","required":true,"schema":{"type":"integer","format":"int32"},"example":1}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/MenuDTO"}}},"required":true},"responses":{"200":{"description":"메뉴 수정 성공","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ResponseMessage"}}}},"400":{"description":"요청 값 또는 카테고리 코드가 잘못됨","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ResponseMessage"}}}},"404":{"description":"수정할 메뉴가 없음","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ResponseMessage"}}}},"500":{"description":"서버 내부 오류","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ResponseMessage"}}}}}},"delete":{"tags":["Menu"],"summary":"메뉴